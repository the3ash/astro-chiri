{
  "name": "astro-chiri",
  "type": "module",
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "tsx scripts/update-link-metadata.ts && astro dev",
    "build": "pnpm run typecheck && tsx scripts/update-link-metadata.ts && astro build",
    "typecheck": "pnpm run typecheck:ts && astro check",
    "typecheck:ts": "tsc --noEmit",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "new": "tsx scripts/new-post.ts",
    "update-link-metadata": "tsx scripts/update-link-metadata.ts",
    "update-theme": "tsx scripts/update-theme.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.4.6",
    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "^0.42.0",
    "feed": "^6.0.0",
    "katex": "^0.18.4",
    "markdown-it": "^15.0.1",
    "mdast-util-to-string": "^4.0.0",
    "node-html-parser": "^9.0.2",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
